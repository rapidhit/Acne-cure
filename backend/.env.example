# Server
PORT=4000
NODE_ENV=production

# Frontend origin allowed to call this API (set to your real domain in prod)
FRONTEND_ORIGIN=http://localhost:5173

# Paystack (get from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Product
PRODUCT_PRICE_KOBO=499          # amount in the smallest currency unit (499 = $4.99 if currency=USD cents, or GHS pesewas etc)
PRODUCT_CURRENCY=USD
PRODUCT_NAME=Flawless Natural Remedies - 8 Steps PDF
PDF_FILE_PATH=./data/flawless-natural-remedies.pdf

# Admin dashboard
ADMIN_PASSWORD=change_this_to_a_strong_password
SESSION_SECRET=change_this_to_a_long_random_string

# Download token expiry (minutes)
DOWNLOAD_TOKEN_TTL_MINUTES=60

# Telegram sale notifications (optional — leave blank to disable)
# Get TELEGRAM_CHAT_ID by messaging your bot once, then visiting:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
