# Server
PORT=4000
NODE_ENV=production

# Frontend origin allowed to call this API (set to your real domain in prod)
FRONTEND_ORIGIN=http://localhost:5173

# Payment gateways — each product picks which one to use from the dashboard.
# Leave a gateway's keys blank if you're not using it; the dashboard will
# flag it as "not configured" and products can't be switched to it until set.

# Paystack (get from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave (get from https://dashboard.flutterwave.com/settings/apis)
# Test-mode keys work fine here even before your account is fully verified.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set this to any random string, then enter the SAME string as the "secret hash"
# in Flutterwave dashboard -> Settings -> Webhooks.
FLUTTERWAVE_WEBHOOK_SECRET=

# Korapay (get from https://dashboard.korapay.com/settings/api-keys)
# Test-mode keys work fine here even before your account is fully verified.
KORAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Product
PRODUCT_PRICE_KOBO=499          # amount in the smallest currency unit (499 = $4.99 if currency=USD cents, or GHS pesewas etc)
PRODUCT_CURRENCY=USD
PRODUCT_NAME=Flawless Natural Remedies - 8 Steps PDF
PDF_FILE_PATH=./data/flawless-natural-remedies.pdf

# Admin dashboard
ADMIN_PASSWORD=change_this_to_a_strong_password
SESSION_SECRET=change_this_to_a_long_random_string

# Download token expiry (minutes)
DOWNLOAD_TOKEN_TTL_MINUTES=60

# Telegram sale notifications (optional — leave blank to disable)
# Get TELEGRAM_CHAT_ID by messaging your bot once, then visiting:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional but recommended: random string, must match what you pass to setWebhook below
TELEGRAM_WEBHOOK_SECRET=

# Support bot — customers message this bot, you reply from your Telegram
# account (by replying to the forwarded message), they only ever see the bot.
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=
SUPPORT_TELEGRAM_WEBHOOK_SECRET=
